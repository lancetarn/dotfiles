[user]
	name = Lance Erickson
	email = lancetarn@gmail.com
[core]
	excludesfile = ~/.gitignore
	pager = hunk pager
[init]
	defaultBranch = main


# hunk: review-style diffs. See https://hunk.dev/docs/workflows/git-pager-and-difftool/
# core.pager above sends diff/show output to hunk; non-diff output (log, etc.)
# falls through to $PAGER or less -R.
[diff]
	tool = hunk
[difftool]
	prompt = false
[difftool "hunk"]
	cmd = hunk difftool \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
